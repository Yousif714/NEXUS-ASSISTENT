# Supabase-Projekt-URL (Projekteinstellungen → API)
SUPABASE_URL=
# Service-Role-Schlüssel von Supabase, nur auf dem Server verwenden, nie im Browser
SUPABASE_SERVICE_ROLE_KEY=
# Geheimnis zum Signieren der Sitzungs-Cookies, mindestens 32 Zeichen
SESSION_SECRET=
# Einmaliger Einrichtungscode für den ersten Passkey des Inhabers
OWNER_SETUP_TOKEN=
# Geheimnis, mit dem sich der Cron-Aufruf ausweist
CRON_SECRET=
# Öffentliche Adresse der App, z. B. https://nexus.example.de (für Passkeys und Herkunftsprüfung)
APP_ORIGIN=
# Paket 2b (optional, nur Production): Stripe Restricted Key, nur lesend
STRIPE_RESTRICTED_KEY=
# Paket 2b (optional): Signing Secret des Stripe-Webhooks (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Paket 2b (optional): Lexware-API-Schlüssel des Kontos NEXUS
LEXWARE_NEXUS_API_KEY=
# Paket 2b (optional): Lexware-API-Schlüssel des Kontos Zulassung
LEXWARE_ZULASSUNG_API_KEY=
# Paket 2b-2 (optional, nur Production): Qonto-API, nur lesend
QONTO_LOGIN=
QONTO_SECRET_KEY=
# optional, Rechnungen lesen (Claude)
ANTHROPIC_API_KEY=
# optional, MCP-Connector für den externen Assistenten (Bearer). Fehlt der Wert, antwortet /api/mcp mit 503.
# Nicht CRON_SECRET, SESSION_SECRET oder den Passkey verwenden.
MCP_API_KEY=
# Paket 2c (optional): eigenes Gmail per IMAP, nur lesen. App-Passwort nach Bestätigung in zwei Schritten.
# Server imap.gmail.com, Port 993, TLS. HOST und PORT nur, wenn der Server abweicht.
# Leerzeichen im App-Passwort (Vierergruppen) werden entfernt.
IMAP_GMAIL_USER=
IMAP_GMAIL_PASSWORD=
# IMAP_GMAIL_HOST=
# IMAP_GMAIL_PORT=
# info@-Postfach (Zulassung), ebenfalls ein normales @gmail.com-Konto. Gleiches App-Passwort-Verfahren.
IMAP_INFO_MAIL_USER=
IMAP_INFO_MAIL_PASSWORD=
# IMAP_INFO_MAIL_HOST=
# IMAP_INFO_MAIL_PORT=
# Optional: iCloud-Mail. Server imap.mail.me.com, Port 993. App-spezifisches Passwort der Apple-ID.
IMAP_ICLOUD_USER=
IMAP_ICLOUD_PASSWORD=
# IMAP_ICLOUD_HOST=
# IMAP_ICLOUD_PORT=
